{
  "name": "volten",
  "description": "A 0-dependency Node.js HTTP framework that is simple, modern, and fast.",
  "keywords": [
    "web",
    "framework",
    "fast",
    "http",
    "router",
    "volten",
    "speed",
    "performance",
    "modern",
    "simple",
    "fast"
  ],
  "version": "0.0.1",
  "author": "insanerx",
  "type": "module",
  "main": "examples/01-hello-world.js",
  "scripts": {
    "build": "pnpm tsc --project tsconfig.build.json",
    "start": "node dist/app.js",
    "dev": "nodemon",
    "test": "tsx tests/run.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "pnpm run lint && pnpm run format",
    "clear": "rm -rf dist/*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.4"
  }
}
