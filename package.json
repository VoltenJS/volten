{
  "name": "volten",
  "version": "0.1.0",
  "description": "A 0-dependency Node.js HTTP framework that is simple, modern, and fast.",
  "author": "insanerx",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/app.js",
    "dev": "nodemon",
    "test": "tsx tests/run.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "pnpm run lint && pnpm run format",
    "clear": "rm -rf dist/*"
  },
  "keywords": [
    "web",
    "framework",
    "fast",
    "http",
    "router",
    "volten",
    "speed",
    "performance",
    "modern",
    "simple",
    "jit"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.4"
  }
}
