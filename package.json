{
  "name": "volten",
  "packageManager": "pnpm@11.0.0",
  "version": "0.0.11",
  "description": "A 0-dependency Node.js HTTP framework that is simple, modern, and fast.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoltenJS/volten.git"
  },
  "bugs": {
    "url": "https://github.com/VoltenJS/volten/issues"
  },
  "homepage": "https://github.com/VoltenJS/volten#readme",
  "author": "insanerx",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.npm.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/app.js",
    "dev": "nodemon",
    "test": "tsx tests/run.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "check": "pnpm run lint && pnpm run format",
    "pack:npm": "node scripts/pack.js",
    "release": "node scripts/release.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "web",
    "framework",
    "fast",
    "http",
    "router",
    "volten",
    "speed",
    "performance",
    "modern",
    "simple",
    "jit"
  ],
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@eslint/js": "^10.0.1",
    "@shikijs/magic-move": "^4.4.3",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@stackblitz/sdk": "^1.11.1",
    "@types/node": "^25.5.2",
    "cytoscape": "^3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "markdown-it-katex": "^2.0.3",
    "mermaid": "^11.17.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "shiki": "^4.4.3",
    "shiki-magic-move": "^1.4.0",
    "tar": "^7.5.22",
    "tsup": "^8.5.1",
    "tsx": "^4.22.5",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.42"
  }
}
